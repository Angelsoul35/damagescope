# DamageScope configuration (prefix DS_)
DS_ENVIRONMENT=local
DS_MODEL_DIR=artifacts
DS_IMAGE_SIZE=128
DS_RESIDUAL_SIGMA=3.0          # threshold = mean + sigma*std of the residual map
DS_MIN_REGION_AREA=20          # ignore damage blobs smaller than this (pixels)
DS_SEVERITY_MEDIUM=0.03        # damaged-area fraction for "medium" severity
DS_SEVERITY_HIGH=0.08          # damaged-area fraction for "high" severity
